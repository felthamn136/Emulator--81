<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifdef Portable?>
    <?define PackageName = "Emulator-81 Portable"?>
    <?define PackageUpgradeCode = "e3032179-75d9-4dce-9a4a-d1dc114801c2"?>
    <?define PackageScope = "perUser"?>
    <?define PackageRoot = "LocalAppDataFolder"?>
    <?define RegistryRoot = "HKCU"?>
    <?define RegistryKey = "Software\Emulator-81\WiX-Portable"?>
  <?else?>
    <?define PackageName = "Emulator-81"?>
    <?define PackageUpgradeCode = "e6056ddc-a567-499a-b5ee-09f8974aedf5"?>
    <?define PackageScope = "perMachine"?>
    <?define PackageRoot = "ProgramFiles64Folder"?>
    <?define RegistryRoot = "HKLM"?>
    <?define RegistryKey = "Software\Emulator-81\WiX"?>
  <?endif?>
  <Package Name="$(PackageName)" Manufacturer="Neil Feltham" Version="0.1.0"
           UpgradeCode="$(PackageUpgradeCode)" Scope="$(PackageScope)">
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of $(PackageName) is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ApplicationIcon.ico" SourceFile="$(ProjectRoot)\packaging\emulator-81.ico" />
    <Property Id="ARPPRODUCTICON" Value="ApplicationIcon.ico" />
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="$(RegistryRoot)"
                      Key="$(RegistryKey)" Name="InstallLocation" Type="raw" />
    </Property>
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />
    <Property Id="PREVIOUSDESKTOPSHORTCUT">
      <RegistrySearch Id="PreviousDesktopShortcut" Root="$(RegistryRoot)"
                      Key="$(RegistryKey)" Name="DesktopShortcut" Type="raw" />
    </Property>

    <StandardDirectory Id="$(PackageRoot)">
      <Directory Id="INSTALLFOLDER" Name="$(PackageName)">
        <Directory Id="AssetsFolder" Name="assets" />
        <Directory Id="RomFolder" Name="rom" />
        <Directory Id="GamesFolder" Name="Games Library" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="$(PackageName)" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <UI>
      <TextStyle Id="InstallerFont" FaceName="Segoe UI" Size="9" />
      <Property Id="DefaultUIFont" Value="InstallerFont" />
      <Dialog Id="InstallOptions" Width="370" Height="140" Title="[ProductName] Setup">
        <Control Id="Description" Type="Text" X="20" Y="20" Width="330" Height="30"
                 Text="Choose whether to add a desktop shortcut, then select Install." />
        <Control Id="DesktopShortcut" Type="CheckBox" X="20" Y="58" Width="310" Height="18"
                 Property="DESKTOPSHORTCUT" CheckBoxValue="1"
                 Text="Create a desktop shortcut" />
        <Control Id="Install" Type="PushButton" X="230" Y="110" Width="56" Height="17"
                 Default="yes" Text="Install">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="294" Y="110" Width="56" Height="17"
                 Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
      <Dialog Id="InstallProgress" Width="370" Height="100" Modeless="yes"
              Title="[ProductName] Setup">
        <Control Id="Status" Type="Text" X="20" Y="20" Width="330" Height="18" TabSkip="no"
                 Text="Please wait while Windows Installer processes [ProductName]." />
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="50" Width="330" Height="15">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
      </Dialog>
      <Dialog Id="InstallComplete" Width="370" Height="100" Title="[ProductName] Setup">
        <Control Id="Message" Type="Text" X="20" Y="20" Width="330" Height="18"
                 Text="[ProductName] setup completed." />
        <Control Id="Finish" Type="PushButton" X="294" Y="70" Width="56" Height="17"
                 Default="yes" Cancel="yes" Text="Finish">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
      <InstallUISequence>
        <Show Dialog="InstallOptions" Before="CostInitialize" Condition="NOT Installed" />
        <Show Dialog="InstallProgress" Before="ExecuteAction" />
        <Show Dialog="InstallComplete" OnExit="success" />
      </InstallUISequence>
    </UI>

    <Feature Id="Application" Title="$(PackageName)" Level="1">
      <Component Directory="INSTALLFOLDER">
        <File Id="EmulatorExecutable" Source="$(WindowsBinary)" KeyPath="yes">
          <Shortcut Id="ApplicationShortcut" Directory="ProgramMenuDir"
                    Name="$(PackageName)" Icon="ApplicationIcon.ico"
                    WorkingDirectory="INSTALLFOLDER" />
        </File>
        <Shortcut Id="UninstallShortcut" Directory="ProgramMenuDir"
                  Name="Uninstall" Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RegistryValue Root="$(RegistryRoot)" Key="$(RegistryKey)"
                       Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" />
        <RemoveFolder Id="RemoveProgramMenuDir" Directory="ProgramMenuDir" On="uninstall" />
      </Component>
      <Component Directory="RomFolder">
        <File Source="$(ProjectRoot)\rom\zx81.rom" KeyPath="yes" />
      </Component>
      <Files Directory="AssetsFolder" Include="$(ProjectRoot)\assets\**" />
      <Files Directory="GamesFolder" Include="$(ProjectRoot)\Games Library\**" />
      <!-- Keep the component enabled during maintenance and uninstall when it was installed. -->
      <Component Directory="DesktopFolder"
                 Condition="DESKTOPSHORTCUT = 1 OR (Installed AND PREVIOUSDESKTOPSHORTCUT = 1)">
        <Shortcut Id="DesktopShortcut" Name="$(PackageName)" Target="[#EmulatorExecutable]"
                  Icon="ApplicationIcon.ico" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="$(RegistryRoot)" Key="$(RegistryKey)"
                       Name="DesktopShortcut" Type="string" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
